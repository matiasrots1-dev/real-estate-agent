# Copiar a .env y completar. Nunca commitear .env con valores reales.

# --- Claude API (Anthropic) ---
ANTHROPIC_API_KEY=

# --- WhatsApp Business Platform (Meta Cloud API) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App Secret de la app de Meta. Es con lo que se valida la firma HMAC de cada
# webhook entrante: si queda vacío, /webhook acepta CUALQUIER POST.
WHATSAPP_APP_SECRET=
# Secreto compartido con el proveedor que reenvía los webhooks (header
# X-DoubleTick-Secret). CONVIVE con la firma HMAC de Meta: si el header no
# viene, se valida la firma como siempre, así que configurarlo no rompe la
# entrega directa de Meta. Vacío = no configurado, y el header se ignora.
# Cuando esté en uso, reemplaza a WHATSAPP_WEBHOOK_SKIP_SIGNATURE_CHECK.
DOUBLETICK_WEBHOOK_SECRET=
# Número de WhatsApp del broker, para las notificaciones de escalamiento
BROKER_WHATSAPP_NUMBER=

# TEMPORAL / INSEGURO — dejar vacío salvo durante una prueba puntual.
# En "true", /webhook acepta webhooks SIN firma HMAC. Existe sólo para probar
# contra un proveedor que reenvía los webhooks de Meta desde su propia
# infraestructura y por lo tanto no puede firmarlos con el App Secret.
# Mientras esté prendido el endpoint no distingue a Meta de cualquiera que
# conozca la URL. Apagarlo apenas termine la prueba y reemplazarlo por un
# secreto compartido con el proveedor (riesgo abierto en docs/TASKS.md).
WHATSAPP_WEBHOOK_SKIP_SIGNATURE_CHECK=

# --- Modo silencioso ---
# El agente recibe, clasifica y le manda el borrador AL BROKER, pero NO le
# responde nada al cliente. Viene PRENDIDO por default (dejar la variable
# vacía lo deja prendido): se apaga sólo escribiendo exactamente "false".
# Es el único flag del proyecto cuyo default seguro es el "true" — activar el
# agente de verdad tiene que ser un acto deliberado, no lo que pasa si no
# configurás nada. Ver docs/TASKS.md Bloque 21.
AGENTE_MODO_SILENCIOSO=

# --- Tokko Broker API ---
TOKKO_API_KEY=
TOKKO_API_BASE_URL=https://www.tokkobroker.com/api/v1

# --- Google Calendar API ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# --- Weather API ---
WEATHER_API_KEY=
WEATHER_API_PROVIDER=openweathermap

# --- Base de datos ---
DATABASE_URL=postgresql://agent:agent_dev_password@localhost:5432/real_estate_agent

# --- General ---
NODE_ENV=development
PORT=3000
DEFAULT_CONFIDENCE_THRESHOLD=0.75

# --- Retención de datos (docs/TASKS.md Bloque 15) ---
# IMPORTANTE: estos plazos tienen que coincidir con la política de privacidad
# publicada de la app. No son un ajuste técnico, son un compromiso público.
RETENTION_MESES_MENSAJES=12
RETENTION_MESES_GESTION_COMERCIAL=24
# Arranca en modo simulacro (solo reporta qué borraría). El borrado es
# irreversible y no hay backup de los JSON: revisá varios reportes en
# data/retention_reports.jsonl antes de poner esto en true.
RETENTION_BORRADO_HABILITADO=false
