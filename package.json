{
  "name": "real-estate-agent",
  "private": true,
  "version": "0.1.0",
  "description": "Agente de IA para automatizar tareas repetitivas de un broker inmobiliario, vía WhatsApp, Tokko Broker y Google Calendar.",
  "workspaces": [
    "apps/*",
    "mcp-servers/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=shared-types && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:orchestrator": "npm run dev --workspace=apps/orchestrator",
    "auth:gcal": "node infra/scripts/get_google_refresh_token.mjs",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "check:sensitive-data": "node scripts/check-sensitive-data.mjs",
    "tokko:telefonos": "node scripts/reporte-telefonos.mjs",
    "recontacto:simulacro": "tsx scripts/simulacro-recontacto.mts",
    "pendientes": "tsx scripts/pendientes.mts",
    "estilo:reanonimizar": "tsx scripts/reanonimizar-estilo.mts"
  },
  "engines": {
    "node": ">=20"
  }
}
